[submodule "external/RadioLib"]
	path = external/RadioLib
	url = https://github.com/jgromes/RadioLib.git
	# pinned to 8.0.0
[submodule "external/pico-sdk"]
	path = external/pico-sdk
	url = https://github.com/raspberrypi/pico-sdk.git
	# pinned to 2.2.0
[submodule "external/BME68x_SensorAPI"]
	path = external/BME68x_SensorAPI
	url = https://github.com/boschsensortec/BME68x_SensorAPI
	# pinned to 4.4.8
[submodule "external/experiment-helpers"]
	path = external/experiment-helpers
	url = git@github.com:antoineomond/power-levels-experiment-helpers.git
